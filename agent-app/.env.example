# Server (localhost only by default - keep it that way, it holds your keys)
PORT=3410
HOST=127.0.0.1

# Required. Every /api request must carry it, so other web pages open in your
# browser cannot read your calendar or documents through localhost. The UI asks
# for it once. The server will not start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=

# Upload / context limits
MAX_UPLOAD_MB=20
MAX_DOC_CHARS=60000
MAX_DOCS=20

# ===== LLM Provider (OpenAI-compatible) =====
# Either set PROVIDER, or a custom BASE_URL for Ollama / LM Studio / etc.
# Examples:
#   OpenAI:   PROVIDER=openai, LLM_MODEL=gpt-4o-mini, LLM_API_KEY=sk-...
#   Anthropic (via OpenAI-compatible proxy): PROVIDER=anthropic
#   Ollama:   LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1, LLM_API_KEY=ollama
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Web search =====
# 'duckduckgo' (no key) | 'tavily' (needs key) | 'none'
WEB_SEARCH=duckduckgo
TAVILY_API_KEY=

# ===== Microsoft Graph (Outlook calendar + OneNote) =====
# Register an app in Azure AD: https://entra.microsoft.com -> App registrations
# Enabled token flows -> "Resource owner password" (legacy, for local use)
# API permissions: Calendars.Read, Notes.Read, offline_access, User.Read
# These values are never written to data/config.json.
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USERNAME=
MS_PASSWORD=
