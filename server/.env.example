PORT=3100
# Required. The server refuses to start with an empty, placeholder or under-32-char
# value, because a predictable signing key lets anyone mint an admin session.
# start.bat generates one for you on first run. To do it by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-real-secret-in-production
MQTT_BROKER=mqtt://localhost:1883
MQTT_GATE_TOPIC=gates/+/command
MQTT_GATE_USERNAME=
MQTT_GATE_PASSWORD=
DB_PATH=C:/qr-intercom-data/intercom.db
HTTPS_PORT=3143
CORS_ORIGIN=*
# Absolute base URL used when generating QR codes. Leave blank to derive from the request.
PUBLIC_BASE_URL=
# Set true only when running behind a reverse proxy you control.
TRUST_PROXY=false
# Send the auth cookie only over HTTPS (turn on once HTTPS is your normal path).
COOKIE_SECURE=false
# Max failed logins per IP per 15 minutes before temporary lockout.
LOGIN_RATE_LIMIT=10
# Initial admin login for a brand-new database (existing databases are not changed).
# Leave the password blank to have one generated and printed on first boot.
# Admins can open every gate, so pick something nobody would guess.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Let anyone create a resident account at /api/auth/register. Residents can answer
# gate calls and open the door, so leave this off unless the network is trusted.
ALLOW_REGISTRATION=false
# Unanswered calls are closed out after this many ms.
RING_TIMEOUT_MS=45000
