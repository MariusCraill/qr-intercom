# ── Server ───────────────────────────────────────────────────────────
# PORT is the direct LAN HTTPS/WSS listener.
# HTTP_PORT is the plain-HTTP backend that the Tailscale funnel proxies to
# (tailscale funnel status maps /api, /ws, /admin, /visit, /resident here).
# HTTP_PORT is the only path the phones and browsers use, so keep it stable
# and make sure it matches the funnel config.
PORT=3011
HTTP_PORT=3010
HOST=0.0.0.0

# Opt in to X-Forwarded-For. Leave false unless you run behind a trusted proxy
# that sets it. If true and something untrusted can set the header, clients can
# spoof req.ip and walk straight around the login rate limiter.
TRUST_PROXY=false

# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Anyone who knows this value can forge a resident or admin JWT.
JWT_SECRET=generate-me-openssl-rand-base64-48
JWT_EXPIRES_IN=7d

# ── MQTT ─────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_GATE_TOPIC_PREFIX=intercom/gate
# Shared secret used to sign gate commands.
MQTT_GATE_SECRET=generate-me-too

# ── Database ─────────────────────────────────────────────────────────
DATABASE_PATH=./data/intercom.db

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist. Do NOT use * together with credentials.
# The three clients are served same-origin by this server, so this only needs
# to list the Vite dev servers during local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://desktop-obtdcvt.tail973ab1.ts.net

# ── TURN (optional, for production WebRTC) ───────────────────────────
# Without TURN, peers behind symmetric NAT will fail to connect.
# Format: [{"urls":"turn:host:3478","username":"u","credential":"p"}]
TURN_SERVERS=[]

# eWeLink gate opening from the resident app. Create an app at
# https://dev.ewelink.cc, add <PUBLIC_BASE_URL>/api/ewelink/callback as its
# redirect URL, and paste its APP ID and APP SECRET here. Leave blank to
# hide the feature. The secret stays on this server; it is never in the APK.
EWELINK_APP_ID=
EWELINK_APP_SECRET=
