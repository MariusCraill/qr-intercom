PORT=3100
JWT_SECRET=change-me-to-a-real-secret-in-production
MQTT_BROKER=mqtt://localhost:1883
MQTT_GATE_TOPIC=gates/+/command
MQTT_GATE_USERNAME=
MQTT_GATE_PASSWORD=
DB_PATH=C:/qr-intercom-data/intercom.db
HTTPS_PORT=3143
CORS_ORIGIN=*
# Absolute base URL used when generating QR codes. Leave blank to derive from the request.
PUBLIC_BASE_URL=
# Set true only when running behind a reverse proxy you control.
TRUST_PROXY=false
# Send the auth cookie only over HTTPS (turn on once HTTPS is your normal path).
COOKIE_SECURE=false
# Max failed logins per IP per 15 minutes before temporary lockout.
LOGIN_RATE_LIMIT=10
# Unanswered calls are closed out after this many ms.
RING_TIMEOUT_MS=45000
